#!/bin/sh
# POST body: type=<dir>&file=<name>
# Раньше принимал GET — любой сторонний сайт мог удалить конфиг простым
# <img src=...>. Теперь только POST + csrf-guard.
echo "Content-type: text/plain"
echo ""

. /www/cgi-bin/_guard.sh
csrf_guard_text

CONFIG_DIR="${CONFIG_DIR:-/root/.config/mihomo}"

if [ "$REQUEST_METHOD" != "POST" ]; then
  echo "Error: POST required"
  exit 1
fi

case "$CONTENT_LENGTH" in
  ''|*[!0-9]*) CONTENT_LENGTH=0 ;;
esac
if [ "$CONTENT_LENGTH" -gt 8192 ]; then
  echo "Error: request body too large"
  exit 1
fi
body=$(head -c "$CONTENT_LENGTH")

field() {
  printf '%s' "$body" | awk -F'&' -v key="$1" '{
    for(i=1;i<=NF;i++) {
      n=length(key)+1
      if (substr($i,1,n) == key"=") { print substr($i,n+1); exit }
    }
  }'
}
urldecode() {
  printf '%s' "$1" | LC_ALL=C awk '
    function hex(c) { c = tolower(c); return index("0123456789abcdef", c) - 1 }
    {
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c == "+") {
          printf " "
        } else if (c == "%" && i + 2 <= length($0) && hex(substr($0, i + 1, 1)) >= 0 && hex(substr($0, i + 2, 1)) >= 0) {
          printf "%c", hex(substr($0, i + 1, 1)) * 16 + hex(substr($0, i + 2, 1))
          i += 2
        } else {
          printf "%s", c
        }
      }
    }'
}

dir_type=$(field type)
[ -z "$dir_type" ] && dir_type="ruleset"
case "$dir_type" in
  ruleset) TARGET_DIR="$CONFIG_DIR/rule_set_list" ;;
  proxy)   TARGET_DIR="$CONFIG_DIR/proxies_mount" ;;
  awg)     TARGET_DIR="$CONFIG_DIR/awg" ;;
  trusttunnel) TARGET_DIR="$CONFIG_DIR/trusttunnel" ;;
  openvpn) TARGET_DIR="$CONFIG_DIR/openvpn" ;;
  fakebin) TARGET_DIR="/zapret-fakebin" ;;
  zlist)   TARGET_DIR="/zapret-lists" ;;
  *) echo "Error: invalid type"; exit 1 ;;
esac

file=$(urldecode "$(field file)")
base=$(basename "$file")
if [ "$base" != "$file" ] || [ -z "$base" ]; then
  echo "Error: invalid filename"
  exit 1
fi

target="$TARGET_DIR/$base"
if [ ! -f "$target" ]; then
  echo "Error: not found"
  exit 1
fi

rm -f "$target"
if [ $? -eq 0 ]; then
  echo "OK"
else
  echo "Error: delete failed"
fi
