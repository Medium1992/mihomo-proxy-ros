#!/bin/sh
# blockcheck2-run — orchestrates parallel DPI strategy testing.
# Usage:
#   blockcheck2-run --job=ID --workers=N --strategies=FILE --domains=FILE --tests=http,tls12,tls13,quic
#
# Writes to:
#   $BC_STATE_DIR/$JOB/log.ndjson   — append-only event stream
#   $BC_STATE_DIR/$JOB/result.txt   — final human-readable report
#   $BC_STATE_DIR/$JOB/status       — running|done|error|cancelled
#   $BC_STATE_DIR/$JOB/.pid         — runner pid (for cancel)
#
# All temp files in /dev/shm to spare flash on RouterOS.

# Sourced lib lives next to the runner. Resolve script dir robustly so it
# works whether invoked as `sh /www/blockcheck2/run …` or via a symlink.
BC_SCRIPT_DIR="${BC_SCRIPT_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
. "$BC_SCRIPT_DIR/lib.sh"
. "$BC_SCRIPT_DIR/report.sh"

JOB=""
WORKERS=8
STRAT_FILE="$BC_SCRIPT_DIR/strategies.list"
DOM_FILE=""
TESTS="http,tls12,tls13"

for arg in "$@"; do
  case "$arg" in
    --job=*)        JOB="${arg#*=}" ;;
    --workers=*)    WORKERS="${arg#*=}" ;;
    --strategies=*) STRAT_FILE="${arg#*=}" ;;
    --domains=*)    DOM_FILE="${arg#*=}" ;;
    --tests=*)      TESTS="${arg#*=}" ;;
    *) echo "unknown arg: $arg" >&2; exit 1 ;;
  esac
done

[ -z "$JOB" ] && { echo "--job required" >&2; exit 1; }
[ -z "$DOM_FILE" ] || [ ! -s "$DOM_FILE" ] && { echo "--domains file missing/empty" >&2; exit 1; }
[ ! -s "$STRAT_FILE" ] && { echo "--strategies file missing/empty" >&2; exit 1; }
case "$WORKERS" in
  ''|*[!0-9]*) echo "--workers must be integer" >&2; exit 1 ;;
esac
[ "$WORKERS" -lt 1 ] && WORKERS=1
[ "$WORKERS" -gt "$BC_WORKER_MAX" ] && WORKERS="$BC_WORKER_MAX"

JOB_DIR="$BC_STATE_DIR/$JOB"
mkdir -p "$JOB_DIR" || { echo "mkdir $JOB_DIR failed" >&2; exit 1; }
LOG="$JOB_DIR/log.ndjson"
RESULT="$JOB_DIR/result.txt"
STATUS="$JOB_DIR/status"
PIDF="$JOB_DIR/.pid"
NFQWS_LOG="$JOB_DIR/nfqws.log"

printf '%s\n' "$$" > "$PIDF"
printf 'running\n' > "$STATUS"

# Strict global lock — only one blockcheck2 job at a time (nfqws+nft are global).
LOCK="$BC_STATE_DIR/.lock"
mkdir -p "$BC_STATE_DIR"
if ! ( set -C; printf '%s\n' "$$" > "$LOCK" ) 2>/dev/null; then
  other=$(cat "$LOCK" 2>/dev/null)
  if [ -n "$other" ] && kill -0 "$other" 2>/dev/null; then
    bc_event error "msg=another blockcheck2 job is running" "pid=$other"
    printf 'error\n' > "$STATUS"
    exit 1
  fi
  # stale lock
  rm -f "$LOCK"
  printf '%s\n' "$$" > "$LOCK"
fi

# ---- JSON event helpers (no jq; manual escaping for strings we generate) -
json_esc() {
  # escape \ and " for JSON string content. control chars unlikely in our values.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}
bc_event() {
  # bc_event TYPE [k=v ...]  — caller must quote each "k=v" if v has spaces.
  local t="$1"; shift
  local ts kv k v extra=""
  ts=$(date +%s)
  for kv in "$@"; do
    case "$kv" in
      *=*) k="${kv%%=*}"; v="${kv#*=}" ;;
      *)   k="$kv"; v="" ;;
    esac
    extra="$extra,\"$k\":\"$(json_esc "$v")\""
  done
  printf '{"ts":%s,"type":"%s"%s}\n' "$ts" "$t" "$extra" >> "$LOG"
}

# ---- Cleanup ------------------------------------------------------------
# При SIGTERM/INT надо ОБЯЗАТЕЛЬНО прибить background subshells диспетчера —
# иначе они продолжают тестить пока probe timeout не истечёт, пишут в лог
# уже после "cancelled" статуса, CPU 100%, остановка не работает.
cleanup() {
  trap - INT TERM EXIT
  # 1. background-джобы диспетчера — каждый держит strategy в полёте.
  # Шлём KILL сразу: при cancel пользователь хочет стоп, а не graceful.
  local p
  for p in $CHILD_PIDS; do
    [ -n "$p" ] && kill -KILL "$p" 2>/dev/null
  done
  # 2. nfqws-воркеры по pidfile'ам.
  local i pidf
  i=0
  while [ "$i" -lt "$WORKERS" ]; do
    pidf="$JOB_DIR/nfqws_$i.pid"
    [ -f "$pidf" ] && bc_nfqws_stop "$pidf"
    i=$((i + 1))
  done
  # 3. Снимаем nft — на этом «вселенная» останавливается.
  bc_nft_teardown
  rm -f "$LOCK"
  bc_event teardown 2>/dev/null || true
}
trap 'cleanup; printf "%s\n" "${BC_FINAL_STATUS:-cancelled}" > "$STATUS"; exit' INT TERM
trap 'cleanup' EXIT

# ---- Preflight ----------------------------------------------------------
if ! bc_preflight 2>>"$LOG"; then
  bc_event error "msg=preflight failed (see nfqws.log / log.ndjson stderr lines)"
  BC_FINAL_STATUS=error
  exit 1
fi
bc_event start "workers=$WORKERS" "tests=$TESTS"

# ---- Provision nft + sweep stale nfqws ---------------------------------
# Defense-in-depth: a previous crash may have left our nft table + nfqws
# processes around. bc_nft_setup teardowns first, but kill stale nfqws too,
# otherwise they'll fight for queue numbers we're about to bind.
bc_kill_stale_nfqws 2>>"$LOG" || true

if ! bc_nft_setup "$WORKERS" 2>>"$LOG"; then
  bc_event error "msg=nft setup failed — kernel may lack nftables. Этот функционал работает только на RouterOS arm64/amd64 версии 7.21 и выше."
  BC_FINAL_STATUS=error
  exit 1
fi
# bc_probe_* needs to know how many workers exist to compute its per-worker
# sub-range of source ports (matched by nft).
export BC_TOTAL_WORKERS="$WORKERS"
# Reset port counters from any prior job — busybox nc has no SO_REUSEADDR,
# so a counter value that landed in TIME_WAIT from the previous run will
# break the first probes of this run with `Address in use`.
rm -f "$BC_STATE_DIR"/.portctr_w* 2>/dev/null
bc_event nft_ready

# ---- Resolve domains via DoH -------------------------------------------
RESOLVED="$JOB_DIR/resolved.txt"
DIAG="$JOB_DIR/doh.diag"
: > "$RESOLVED"
: > "$DIAG"
export BC_DOH_DIAG="$DIAG"

bc_append_resolved() {
  local host="$1" path="$2" mode="$3" ip diag_tail
  [ -z "$host" ] && return 1
  ip=$(bc_doh_resolve "$host" | head -n1)
  if [ -z "$ip" ]; then
    diag_tail=$(tail -c 300 "$DIAG" 2>/dev/null | tr '\n\r\t' '   ')
    bc_event resolve_fail "host=$host" "diag=$diag_tail"
    return 1
  fi
  printf '%s\t%s\t%s\t%s\n' "$host" "$ip" "$path" "$mode" >> "$RESOLVED"
  bc_nft_add_target "$ip" 2>>"$LOG"
  if [ -n "$mode" ]; then
    bc_event resolve "host=$host" "ip=$ip" "path=$path" "mode=$mode"
  elif [ -n "$path" ]; then
    bc_event resolve "host=$host" "ip=$ip" "path=$path"
  else
    bc_event resolve "host=$host" "ip=$ip"
  fi
}

# Форматы: `host[/path]`, `scheme://host[/path]`, `@full <URL>` (throughput-режим).
# Авто-throughput: `*.googlevideo.com/videoplayback*`.
while IFS= read -r raw || [ -n "$raw" ]; do
  raw=$(printf '%s' "$raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/\r$//')
  [ -z "$raw" ] && continue
  case "$raw" in \#*) continue ;; esac
  mode=""
  youtube_full=0
  case "$raw" in
    '@full '*|'@full	'*)
      rest=$(printf '%s' "$raw" | sed 's/^@full[[:space:]]*//')
      case "$rest" in
        https://*) rest="${rest#https://}" ;;
        http://*)  rest="${rest#http://}"  ;;
      esac
      case "$rest" in
        */*) host="${rest%%/*}"; path="/${rest#*/}" ;;
        *)   host="$rest";       path="/"           ;;
      esac
      mode="throughput"
      case "$host/$path" in *.googlevideo.com/*/videoplayback*) youtube_full=1; mode="youtube_throughput" ;; esac
      ;;
    *)
      case "$raw" in
        https://*) raw="${raw#https://}" ;;
        http://*)  raw="${raw#http://}"  ;;
      esac
      case "$raw" in
        */*) host="${raw%%/*}"; path="/${raw#*/}" ;;
        *)   host="$raw";       path=""           ;;
      esac
      case "$host" in
        *.googlevideo.com)
          case "$path" in */videoplayback*) mode="throughput" ;; esac
          ;;
      esac
      ;;
  esac
  [ -z "$host" ] && continue
  if [ "$youtube_full" = 1 ]; then
    bc_append_resolved "www.youtube.com" "" "youtube_support" || true
    bc_append_resolved "redirector.googlevideo.com" "" "youtube_support" || true
    bc_append_resolved "i.ytimg.com" "" "youtube_support" || true
  fi
  bc_append_resolved "$host" "$path" "$mode" || continue
done < "$DOM_FILE"
if [ ! -s "$RESOLVED" ]; then
  diag_full=$(tail -c 500 "$DIAG" 2>/dev/null | tr '\n\r\t' '   ')
  bc_event error "msg=no domains resolved via DoH" "diag=$diag_full"
  BC_FINAL_STATUS=error
  exit 1
fi

# ---- Baseline sanity check ---------------------------------------------
# Test that an unblocked control host works WITHOUT any DPI strategy.
# If this fails, our infra is broken (worker UID/nft/skuid setup, mihomo
# TPROXY collision, etc.) — and reporting "0 working strategies" would be
# misleading. We use iana.org (same control as blockcheck2.sh).
BC_BASELINE_HOST="${BC_BASELINE_HOST:-iana.org}"
baseline_ip=$(bc_doh_resolve "$BC_BASELINE_HOST" | head -n1)
if [ -n "$baseline_ip" ]; then
  # Use worker 0 (already provisioned), no nfqws — pure direct path.
  # Baseline always runs handshake-only — iana.org doesn't host the
  # user-supplied probe path (e.g. /1MB.bin), so a size-gated baseline
  # would always fail and falsely flag "infra broken".
  if BC_HARD_BODY=0 bc_probe_tls 0 "$BC_BASELINE_HOST" "$baseline_ip" tls1_2; then
    bc_event baseline "host=$BC_BASELINE_HOST" "ip=$baseline_ip" "result=ok"
  else
    bc_event baseline "host=$BC_BASELINE_HOST" "ip=$baseline_ip" "result=fail" \
      "warn=control host TLS unreachable from worker UID — strategies WILL likely all fail. Probable cause: mihomo TPROXY catches worker traffic before nfqws. Check nft list ruleset."
  fi
else
  bc_event baseline "host=$BC_BASELINE_HOST" "result=unresolved"
fi

# ---- Pre-flight: validate signed / expiring video links -----------------
# googlevideo /videoplayback URLs are signed and die after ~6h → HTTP 403.
# An expired link makes EVERY youtube strategy "fail", falsely reporting
# "0 working strategies". So probe each throughput target once, DIRECT (no
# nfqws), before grinding the whole queue:
#   403           → server reachable but link dead → stop, ask for a fresh one.
#   2xx           → link alive, proceed.
#   unreachable   → NOT conclusive: this is exactly the DPI case we're about
#                   to test (ISP blocks googlevideo directly) — proceed and
#                   let the post-run analysis flag an all-403 outcome.
while IFS=$(printf '\t') read -r pf_host pf_ip pf_path pf_mode; do
  case "$pf_mode" in youtube_throughput) ;; *) continue ;; esac
  [ -z "$pf_ip" ] && continue
  pf_status=$(bc_link_status "$pf_host" "$pf_ip" "$pf_path")
  bc_event link_preflight "host=$pf_host" "status=${pf_status:-none}"
  if [ "$pf_status" = 403 ]; then
    bc_event link_expired "host=$pf_host" "phase=preflight" \
      "msg=Ссылка на видео устарела (HTTP 403). Она подписана и живёт ~6 часов — получите свежую googlevideo-ссылку и запустите проверку заново."
    BC_FINAL_STATUS=link_expired
    printf 'link_expired\n' > "$STATUS"
    exit 1
  fi
done < "$RESOLVED"

# ---- Build expanded strategy queue --------------------------------------
# Each line: NAME|PROTO|ARGS
STRAT_Q="$JOB_DIR/queue.txt"
grep -vE '^[[:space:]]*(#|$)' "$STRAT_FILE" > "$STRAT_Q"
TOTAL=$(wc -l < "$STRAT_Q")
bc_event queue "total=$TOTAL"

# Worker state: $JOB_DIR/w<K>.free  (file exists ⇒ worker idle)
i=0
while [ "$i" -lt "$WORKERS" ]; do
  touch "$JOB_DIR/w${i}.free"
  i=$((i + 1))
done

# ---- Test types map -----------------------------------------------------
want_http=0; want_tls12=0; want_tls13=0; want_quic=0
case ",$TESTS," in *,http,*)  want_http=1  ;; esac
case ",$TESTS," in *,tls12,*) want_tls12=1 ;; esac
case ",$TESTS," in *,tls13,*) want_tls13=1 ;; esac
case ",$TESTS," in *,quic,*)  want_quic=1  ;; esac

# ---- Per-strategy probe function (runs in subshell of dispatcher) -------
# Args: $1=worker_idx  $2=strategy_line  [$3=event type, default strategy;
# повторная проверка лучших пишет retest] → writes events, never fails the caller.
run_strategy() {
  local k="$1" line="$2" ev_type="${3:-strategy}"
  local name proto args
  name="${line%%|*}";  line="${line#*|}"
  proto="${line%%|*}"; args="${line#*|}"

  local pidf="$JOB_DIR/nfqws_${k}.pid"
  rm -f "$pidf"

  # Skip whole strategy if its proto matches no enabled test (no point
  # spawning nfqws just to skip every per-tt probe inside).
  local relevant=0
  case "$proto" in
    http)          [ "$want_http" = 1 ]  && relevant=1 ;;
    tls)           { [ "$want_tls12" = 1 ] || [ "$want_tls13" = 1 ]; } && relevant=1 ;;
    tls12)         [ "$want_tls12" = 1 ] && relevant=1 ;;
    tls13)         [ "$want_tls13" = 1 ] && relevant=1 ;;
    quic)          [ "$want_quic" = 1 ]  && relevant=1 ;;
    combined)      relevant=1 ;;
  esac
  if [ "$relevant" = 0 ]; then
    bc_event strategy_skip "name=$name" "proto=$proto" "reason=proto_not_in_tests"
    return 0
  fi

  bc_event strategy_start "name=$name" "proto=$proto" "worker=$k"

  if ! bc_nfqws_start "$k" "$proto" "$args" "$pidf" "$NFQWS_LOG"; then
    local nf_tail
    nf_tail=$(tail -c 400 "$NFQWS_LOG" 2>/dev/null | tr '\n\r\t' '   ')
    bc_event strategy_skip "name=$name" "reason=nfqws_start_failed" "nfqws_tail=$nf_tail"
    return 0
  fi
  # Brief settle (nfqws hooks into queue).
  sleep 0.05 2>/dev/null || sleep 1

  local pass=0 fail=0 flaky=0 skip=0 detail="" host ip path mode tt want ok reps rnd_reps
  # Каждая проба повторяется BC_ATTEMPTS раз (bc_attempts): прошли все —
  # ok, первая не прошла — fail, прошла не каждая — flaky (нестабильно).
  # Стратегии с rnd-элементами (tls_mod=rnd и т.п.) — не меньше
  # BC_PROBE_RND_REPEATS: рандомный ClientHello может проскочить случайно.
  reps="${BC_ATTEMPTS:-1}"
  case "$reps" in ''|*[!0-9]*) reps=1 ;; esac
  [ "$reps" -lt 1 ] && reps=1
  case "$args" in
    *rnd*)
      rnd_reps="${BC_PROBE_RND_REPEATS:-2}"
      case "$rnd_reps" in ''|*[!0-9]*) rnd_reps=2 ;; esac
      [ "$rnd_reps" -gt "$reps" ] && reps="$rnd_reps"
      ;;
  esac
  [ "$ev_type" = retest ] && [ "$reps" -lt 3 ] && reps=3
  # Лейблы режима для detail. Подсказывают пользователю что именно
  # тестировалось: handshake-only / body-mode с порогом / throughput.
  hard_kb=$((BC_HARD_MIN_BYTES / 1024))
  tp_kb=$((BC_THROUGHPUT_BYTES / 1024))
  tp_sec="${BC_THROUGHPUT_MAX_SEC:-5}"
  youtube_bytes="${BC_YOUTUBE_THROUGHPUT_BYTES:-2097152}"
  youtube_quality="${BC_YOUTUBE_QUALITY:-480p}"
  case "$youtube_bytes" in ''|*[!0-9]*) youtube_bytes=2097152 ;; esac
  case "$youtube_quality" in 240p|360p|480p|720p|1080p) ;; *) youtube_quality=480p ;; esac
  youtube_kb=$((youtube_bytes / 1024))
  while IFS=$(printf '\t') read -r host ip path mode; do
    [ -z "$host" ] && continue
    if [ "$mode" = "youtube_support" ]; then
      bc_attempts "$reps" bc_probe_tls "$k" "$host" "$ip" tls1_3
      ok=$?
      if [ "$ok" = 1 ]; then
        bc_attempts "$reps" bc_probe_tls "$k" "$host" "$ip" tls1_2
        ok=$?
      fi
      case "$ok" in
        0) pass=$((pass + 1)); detail="${detail:+$detail,}$host/youtube-hs=ok" ;;
        2) flaky=$((flaky + 1)); detail="${detail:+$detail,}$host/youtube-hs=flaky" ;;
        *) fail=$((fail + 1)); detail="${detail:+$detail,}$host/youtube-hs=fail" ;;
      esac
      continue
    fi
    if [ "$mode" = "throughput" ] || [ "$mode" = "youtube_throughput" ]; then
      if [ "$mode" = "youtube_throughput" ]; then
        BC_THROUGHPUT_BYTES="$youtube_bytes" bc_attempts "$reps" bc_probe_throughput "$k" "$host" "$ip" "$path"; ok=$?
        thr_tag="youtube-${youtube_quality}-${youtube_kb}k/${tp_sec}s"
      else
        bc_attempts "$reps" bc_probe_throughput "$k" "$host" "$ip" "$path"; ok=$?
        thr_tag="throughput-${tp_kb}k/${tp_sec}s"
      fi
      if [ "$ok" = 0 ]; then
        pass=$((pass + 1)); detail="${detail:+$detail,}$host/$thr_tag=ok"
      elif [ "$ok" = 2 ]; then
        flaky=$((flaky + 1)); detail="${detail:+$detail,}$host/$thr_tag=flaky"
      else
        fail=$((fail + 1))
        # 403 = стратегия достучалась до сервера (TLS прошёл), но подписанная
        # ссылка мертва. Метим отдельным тегом, чтобы финальный отчёт отличил
        # протухшую ссылку от реального DPI-блока (=fail).
        thr_st=$(cat "${BC_STATE_DIR}/.thr_status_w${k}" 2>/dev/null)
        if [ "$thr_st" = 403 ]; then
          detail="${detail:+$detail,}$host/$thr_tag=403"
        else
          detail="${detail:+$detail,}$host/$thr_tag=fail"
        fi
      fi
      continue
    fi
    if [ -n "$path" ]; then
      export BC_HARD_BODY=1 BC_HARD_PATH="$path"
      mode_tag="body-${hard_kb}k"
    else
      export BC_HARD_BODY=0
      mode_tag="hs"
    fi
    for tt in http tls12 tls13 quic; do
      eval "want=\$want_$tt"
      [ "$want" = 1 ] || continue
      # QUIC probe всегда handshake-only (тело UDP не качаем).
      if [ "$tt" = "quic" ]; then
        tt_mode_tag="hs"
      else
        tt_mode_tag="$mode_tag"
      fi
      case "$proto/$tt" in
        http/http)         bc_attempts "$reps" bc_probe_http "$k" "$host" "$ip"; ok=$? ;;
        tls/tls12)         bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_2; ok=$? ;;
        tls/tls13)         bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_3; ok=$? ;;
        tls12/tls12)       bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_2; ok=$? ;;
        tls13/tls13)       bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_3; ok=$? ;;
        combined/http)     bc_attempts "$reps" bc_probe_http "$k" "$host" "$ip"; ok=$? ;;
        combined/tls12)    bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_2; ok=$? ;;
        combined/tls13)    bc_attempts "$reps" bc_probe_tls  "$k" "$host" "$ip" tls1_3; ok=$? ;;
        combined/quic)     bc_attempts "$reps" bc_probe_quic "$k" "$host" "$ip"; ok=$? ;;
        quic/quic)         bc_attempts "$reps" bc_probe_quic "$k" "$host" "$ip"; ok=$? ;;
        *)                 ok=skip ;;
      esac
      # detail items joined by ',' (no spaces) so we can pass it as a single quoted arg.
      case "$ok" in
        0)    pass=$((pass + 1)); detail="${detail:+$detail,}$host/$tt-$tt_mode_tag=ok" ;;
        2)    flaky=$((flaky + 1)); detail="${detail:+$detail,}$host/$tt-$tt_mode_tag=flaky" ;;
        skip) skip=$((skip + 1)) ;;
        *)    fail=$((fail + 1)); detail="${detail:+$detail,}$host/$tt-$tt_mode_tag=fail" ;;
      esac
    done
  done < "$RESOLVED"

  bc_nfqws_stop "$pidf"
  bc_event "$ev_type" "name=$name" "proto=$proto" "pass=$pass" "fail=$fail" "flaky=$flaky" "skip=$skip" "detail=$detail" "args=$args"
}

# ---- Dispatcher (simple polling) ---------------------------------------
DONE=0
CHILD_PIDS=""
while IFS= read -r strat_line; do
  [ -z "$strat_line" ] && continue
  # Pick a free worker.
  while :; do
    k=0
    chosen=""
    while [ "$k" -lt "$WORKERS" ]; do
      if [ -f "$JOB_DIR/w${k}.free" ]; then
        chosen="$k"
        break
      fi
      k=$((k + 1))
    done
    if [ -n "$chosen" ]; then
      rm -f "$JOB_DIR/w${chosen}.free"
      (
        run_strategy "$chosen" "$strat_line"
        touch "$JOB_DIR/w${chosen}.free"
      ) &
      CHILD_PIDS="$CHILD_PIDS $!"
      DONE=$((DONE + 1))
      bc_event progress "done=$DONE" "total=$TOTAL"
      break
    fi
    # all busy — wait a bit
    sleep 0.1 2>/dev/null || sleep 1
  done
done < "$STRAT_Q"

# Ждём фоновые subshells по ЯВНОМУ списку PID (а не `jobs -p` — последний
# в command substitution в busybox sh может цепляться за зомби и считать
# их живыми вечно, отсюда было «132/132 но всё ещё тестирует»).
# Дедлайн 60с после диспетчера: probe timeout=8с, run_strategy при штатной
# работе укладывается в десятки секунд. Кто после 60с — действительно
# завис; шлём SIGKILL без церемоний.
WAIT_DEADLINE=$(( $(date +%s) + 60 ))
while [ -n "$CHILD_PIDS" ]; do
  REMAINING=""
  for p in $CHILD_PIDS; do
    kill -0 "$p" 2>/dev/null && REMAINING="$REMAINING $p"
  done
  CHILD_PIDS="$REMAINING"
  [ -z "$CHILD_PIDS" ] && break
  if [ "$(date +%s)" -ge "$WAIT_DEADLINE" ]; then
    bc_event warn "msg=wait deadline (60s); SIGKILL stuck subshells"
    for p in $CHILD_PIDS; do
      kill -KILL "$p" 2>/dev/null
    done
    break
  fi
  sleep 0.2 2>/dev/null || sleep 1
done
wait 2>/dev/null
bc_event progress "done=$DONE" "total=$TOTAL"

# ---- Final report -------------------------------------------------------
# Итог (report.sh):
#   1) ранжирование: сначала стратегии без единой неудачной/нестабильной
#      пробы, затем больше прошедших, затем проще (cost) — READY-TO-USE берёт
#      лучшую по каждому proto, а не первую закончившуюся;
#   2) повторная проверка трёх лучших TLS сразу после прогона (nfqws2):
#      адаптивный DPI пропускает первые соединения и режет повторные;
#   3) класс DPI по диагностическому корпусу cls01..cls34;
#   4) лестница circular из лучших TLS — сама переключается на следующую
#      ступень, когда текущая перестаёт работать.
RANKED="$JOB_DIR/.ranked.tsv"
bc_event report_building 2>/dev/null || true
bc_ranked "$LOG" > "$RANKED" 2>/dev/null

QUIC_DEFAULT="${BC_QUIC_DEFAULT:---filter-udp=0-65535 --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=20}"

IS_NFQWS2=0
case "${BC_NFQWS##*/}" in nfqws2) IS_NFQWS2=1 ;; esac

# Повторная проверка. Только full TLS-стратегии: у остальных и так видно,
# что они не держатся. По одной, на воркере 0, не меньше трёх попыток.
RETEST_VERDICT=""
if [ "$IS_NFQWS2" = 1 ] && [ "${BC_RETEST:-1}" = 1 ] && { [ "$want_tls12" = 1 ] || [ "$want_tls13" = 1 ]; }; then
  CHAMPS="$JOB_DIR/.champs.tsv"
  awk -F'\t' '$1 == 1 && $5 == "tls" && n < 3 { n++; print $4 "|" $5 "|" $10 }' "$RANKED" > "$CHAMPS"
  if [ -s "$CHAMPS" ]; then
    n_ch=$(wc -l < "$CHAMPS" | tr -d ' ')
    bc_event retest_start "count=$n_ch"
    while IFS= read -r ch; do
      run_strategy 0 "$ch" retest
    done < "$CHAMPS"
    RETESTED="$JOB_DIR/.retested.tsv"
    bc_ranked "$LOG" retest > "$RETESTED" 2>/dev/null
    survived=$(awk -F'\t' '$1 == 1 { printf "%s%s", (n++ ? " " : ""), $4 }' "$RETESTED")
    died=""
    while IFS='|' read -r ch_name _ch_rest; do
      case " $survived " in *" $ch_name "*) ;; *) died="${died:+$died }$ch_name" ;; esac
    done < "$CHAMPS"
    if [ -z "$died" ]; then
      RETEST_VERDICT="stable"
    elif [ -z "$survived" ]; then
      RETEST_VERDICT="adaptive"
    else
      RETEST_VERDICT="partial"
    fi
    bc_event retest_verdict "verdict=$RETEST_VERDICT" "survived=$survived" "died=$died"
    # Умершие при повторе уходят в конец ранга: повтор надёжнее одного прогона.
    if [ -n "$died" ]; then
      awk -F'\t' -v died=" $died " 'BEGIN { OFS = "\t" } index(died, " " $4 " ") { $1 = 0 } { print }' "$RANKED" \
        | sort -t "$(printf '\t')" -k1,1nr -k2,2nr -k3,3n -k4,4 > "$RANKED.tmp" && mv "$RANKED.tmp" "$RANKED"
    fi
    rm -f "$CHAMPS" "$RETESTED"
  fi
fi

BEST_HTTP_ARGS=$(bc_best "$RANKED" http)
BEST_TLS_ARGS=$(bc_best "$RANKED" tls tls12 tls13)
BEST_QUIC_ARGS=$(bc_best "$RANKED" quic)
[ -n "$BEST_HTTP_ARGS" ] && bc_event best "proto=http" "name=$(awk -F'\t' '$5=="http"{print $4; exit}' "$RANKED")" "args=$BEST_HTTP_ARGS"
[ -n "$BEST_TLS_ARGS" ] && bc_event best "proto=tls" "name=$(awk -F'\t' '$5=="tls"||$5=="tls12"||$5=="tls13"{print $4; exit}' "$RANKED")" "args=$BEST_TLS_ARGS"
[ -n "$BEST_QUIC_ARGS" ] && bc_event best "proto=quic" "name=$(awk -F'\t' '$5=="quic"{print $4; exit}' "$RANKED")" "args=$BEST_QUIC_ARGS"
QUIC_PART="$BEST_QUIC_ARGS"
[ -z "$QUIC_PART" ] && QUIC_PART="$QUIC_DEFAULT"

# join_new A B C → непустые через --new.
join_new() {
  local out="" p
  for p in "$@"; do
    [ -n "$p" ] || continue
    out="${out:+$out --new }$p"
  done
  printf '%s' "$out"
}
COMBINED=""
[ -n "$BEST_HTTP_ARGS$BEST_TLS_ARGS" ] && COMBINED=$(join_new "$BEST_HTTP_ARGS" "$BEST_TLS_ARGS" "$QUIC_PART")
[ -n "$COMBINED" ] && bc_event ready "args=$COMBINED"

CLASS_TSV="$JOB_DIR/.class.tsv"
: > "$CLASS_TSV"
LADDER=""
LADDER_COMBINED=""
if [ "$IS_NFQWS2" = 1 ]; then
  bc_class "$LOG" > "$CLASS_TSV" 2>/dev/null
  while IFS="$(printf '\t')" read -r c_ver c_class c_text c_rec c_name c_args c_st; do
    [ "$c_name" = - ] && c_name=""
    [ "$c_args" = - ] && c_args=""
    [ "$c_st" = - ] && c_st=""
    bc_event class "ver=$c_ver" "class=$c_class" "verdict=$c_text" "rec=$c_rec" "name=$c_name" "args=$c_args" "stable=$c_st"
  done < "$CLASS_TSV"
  LADDER=$(bc_ladder "$RANKED")
  if [ -n "$LADDER" ]; then
    LADDER_COMBINED=$(join_new "$BEST_HTTP_ARGS" "$LADDER" "$QUIC_PART")
    bc_event ladder "steps=$(printf '%s' "$LADDER" | grep -o ':strategy=[0-9]*' | sort -u | wc -l | tr -d ' ')" "args=$LADDER" "combined=$LADDER_COMBINED"
  fi
fi

# Post-run link-health check: если ВСЕ throughput/youtube-пробы вернули 403
# и ни одной =ok — подписанная видео-ссылка почти наверняка протухла (в т.ч.
# мид-скан на 6ч-границе, или ISP режет direct и пред-флайт не смог поймать).
# Предупреждаем явно, иначе «0 рабочих» читается как «DPI блокирует всё».
link_403=$(grep -c 'youtube-[^,"]*=403' "$LOG" 2>/dev/null)
case "$link_403" in ''|*[!0-9]*) link_403=0 ;; esac
link_thr_ok=$(grep -c 'youtube-[^,"]*=ok' "$LOG" 2>/dev/null)
case "$link_thr_ok" in ''|*[!0-9]*) link_thr_ok=0 ;; esac
LINK_EXPIRED=0
if [ "$link_403" -gt 0 ] && [ "$link_thr_ok" = 0 ]; then
  LINK_EXPIRED=1
  bc_event link_expired "phase=postrun" "count403=$link_403" \
    "msg=Все проверки видеопотока вернули 403 — ссылка устарела (~6ч). Замените googlevideo-ссылку и запустите заново; результаты по видео недостоверны."
fi

# Комбинации http × tls × quic из трёх лучших по рангу каждого proto.
COMBINED_LIST=$(
  awk -F'\t' -v qdef="$QUIC_DEFAULT" '
    $5=="http" && hc<3 { h[++hc] = $10 }
    ($5=="tls" || $5=="tls12" || $5=="tls13") && tc<3 { t[++tc] = $10 }
    $5=="quic" && qc<3 { q[++qc] = $10 }
    END {
      if (qc==0) { q[1] = qdef; qc=1 }
      if (hc==0 && tc==0) exit
      hl = hc>0 ? hc : 1; tl = tc>0 ? tc : 1
      for (i=1; i<=hl; i++) for (j=1; j<=tl; j++) for (k=1; k<=qc; k++) {
        line = ""
        if (hc>0) line = h[i]
        if (tc>0) line = (line ? line " --new " : "") t[j]
        line = (line ? line " --new " : "") q[k]
        print line
      }
    }
  ' "$RANKED" 2>/dev/null
)

{
  if [ "$LINK_EXPIRED" = 1 ]; then
    echo "################################################################"
    echo "!!  ССЫЛКА НА ВИДЕО УСТАРЕЛА (HTTP 403)"
    echo "    Все проверки googlevideo вернули 403. Подписанная ссылка живёт"
    echo "    ~6 часов — результаты по видеопотоку НЕДОСТОВЕРНЫ. Получите"
    echo "    свежую googlevideo-ссылку и запустите проверку заново."
    echo "################################################################"
    echo
  fi
  echo "blockcheck2 job: $JOB"
  echo "workers: $WORKERS  tests: $TESTS  attempts: ${BC_ATTEMPTS:-1}"
  echo "domains:"
  awk -F'\t' '{ printf "  %s -> %s\n", $1, $2 }' "$RESOLVED"
  echo
  if [ -s "$CLASS_TSV" ]; then
    echo "================================================================"
    echo "Класс DPI (диагностический корпус cls01..cls34):"
    echo "================================================================"
    awk -F'\t' '{
      printf "%s: %s — %s\n", ($1 == "tls12" ? "TLS 1.2" : "TLS 1.3"), $2, $3
      printf "  стабильно прошли строки: %s\n", ($7 == "-" ? "нет" : $7)
      if ($4 > 0) printf "  минимальная рабочая: %s\n  %s\n", $5, $6
    }' "$CLASS_TSV"
    echo
  fi
  case "$RETEST_VERDICT" in
    stable)   echo "Повторная проверка: лучшие TLS-стратегии пережили повтор — признаков адаптивного DPI нет."; echo ;;
    partial)  echo "Повторная проверка: часть лучших TLS-стратегий не пережила повтор — DPI, похоже, адаптивный; они опущены в конец списка."; echo ;;
    adaptive) echo "Повторная проверка: ни одна из лучших TLS-стратегий не пережила повтор — DPI адаптивный. Берите лестницу ниже или туннель."; echo ;;
  esac
  echo "================================================================"
  echo "READY-TO-USE  (paste into ZAPRET2_CMD0):"
  echo "================================================================"
  if [ -n "$COMBINED" ]; then
    printf '%s\n' "$COMBINED"
  else
    echo "(no working strategies found — DPI блокирует все варианты, либо стоит увеличить уровень / включить fakebin)"
  fi
  echo
  if [ -n "$LADDER_COMBINED" ]; then
    echo "================================================================"
    echo "Лестница (circular): TLS сам переходит на следующую рабочую стратегию,"
    echo "когда текущая перестаёт работать:"
    echo "================================================================"
    printf '%s\n\n' "$LADDER_COMBINED"
  fi
  if [ -n "$COMBINED_LIST" ]; then
    echo "================================================================"
    echo "Combined strategies (top-3 per proto, max 27 combinations):"
    echo "================================================================"
    printf '%s\n' "$COMBINED_LIST" | awk '{ printf "%d) %s\n", NR, $0 }'
    echo
  fi
  echo "================================================================"
  echo "Working strategies, лучшие сверху (with full nfqws args):"
  echo "================================================================"
  if [ -s "$RANKED" ]; then
    awk -F'\t' '{
      printf "[%s] %s  pass=%s fail=%s flaky=%s skip=%s%s\n  detail: %s\n  args:   %s\n\n",
        $5, $4, $2, $6, $7, $8, ($1 == 1 ? "" : "  (не все пробы)"), $9, $10
    }' "$RANKED"
  else
    echo "(пусто)"
  fi
  echo "================================================================"
  echo "Full event log: $LOG"
} > "$RESULT"
rm -f "$RANKED" "$CLASS_TSV"

BC_FINAL_STATUS=done
printf 'done\n' > "$STATUS"
bc_event end
