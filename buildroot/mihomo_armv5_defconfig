# Target: ARMv5TEJ (arm926ej-s), EABI soft-float, musl — как у прежнего rootfs.
BR2_arm=y
BR2_arm926t=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_ROOTFS_MERGED_USR=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/home/br/busybox-httpd.fragment"
# Набор Alpine armv7: ca-certificates busybox-extras openssl tzdata iproute2
# iptables iptables-legacy jq. Остальное было и в прежнем rootfs.
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_JQ=y
# Без oniguruma jq не умеет test/sub/gsub, а на них держится xray2mihomo.jq.
BR2_PACKAGE_ONIGURUMA=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_ZLIB=y
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
