FROM --platform=$BUILDPLATFORM alpine:latest AS package
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG AMD64VERSION
ARG TAG
ARG GO_VERSION
ARG MIHOMO_CUSTOM_PATCHES=1
ARG VERSION_OVERRIDE=""
# Без gVisor бинарник на ~9 МиБ меньше (arm64, 1.19.31). Контейнер gVisor не
# использует: TUN на mipstack, WireGuard/AWG/OpenVPN/MASQUE/ZeroTier тоже.
# Нужен он только исходящему Tailscale — для него CI отдельно собирает
# вариант с WITH_GVISOR=1 и публикует образы с суффиксом -gvisor.
ARG WITH_GVISOR=0
ARG BUILDTIME
RUN apk add --no-cache curl jq gzip tar unzip git make python3

RUN [ -n "$GO_VERSION" ] || { echo "GO_VERSION build arg is required"; exit 1; } && \
    echo "Using Go ${GO_VERSION} from MetaCubeX/go build release" && \
    case "$(apk --print-arch)" in \
        x86_64) GO_BUILD_ARCH=amd64 ;; \
        aarch64) GO_BUILD_ARCH=arm64 ;; \
        *) echo "Unsupported Go build arch: $(apk --print-arch)" && exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/MetaCubeX/go/releases/download/build/go${GO_VERSION}.linux-${GO_BUILD_ARCH}.tar.gz" | \
    tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}" \
    GOTOOLCHAIN=local
RUN go version

RUN mkdir -p /final 

# Клонируем репозиторий
RUN git clone --depth=1 https://github.com/MetaCubeX/mihomo.git /src

WORKDIR /src

# Универсальное переключение: работает и с тегами (v1.xx), и с short hash из Alpha
RUN git fetch --all --tags --prune && \
    git fetch origin "$TAG" --depth=10 2>/dev/null || true && \
    (git checkout --detach "$TAG" 2>/dev/null || git checkout "$TAG") || \
    { echo "ERROR: Failed to checkout $TAG"; git branch -a; exit 1; }

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        echo "Applying mihomo-proxy-ros updater patches"; \
        sed -i 's|baseReleaseURL    = "https://github.com/MetaCubeX/mihomo/releases/latest/download/"|baseReleaseURL    = "https://github.com/Medium1992/mihomo-proxy-ros/releases/latest/download/"|' component/updater/update_core.go; \
        sed -i 's|versionReleaseURL = "https://github.com/MetaCubeX/mihomo/releases/latest/download/version.txt"|versionReleaseURL = "https://github.com/Medium1992/mihomo-proxy-ros/releases/latest/download/version.txt"|' component/updater/update_core.go; \
        sed -i 's|baseAlphaURL    = "https://github.com/MetaCubeX/mihomo/releases/download/Prerelease-Alpha/"|baseAlphaURL    = "https://github.com/Medium1992/mihomo-proxy-ros/releases/download/alpha/"|' component/updater/update_core.go; \
        sed -i 's|versionAlphaURL = "https://github.com/MetaCubeX/mihomo/releases/download/Prerelease-Alpha/version.txt"|versionAlphaURL = "https://github.com/Medium1992/mihomo-proxy-ros/releases/download/alpha/version.txt"|' component/updater/update_core.go; \
    else \
        echo "Skipping mihomo-proxy-ros updater patches"; \
    fi

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        sed -i '/^import (/a\    "github.com/metacubex/mihomo/log"' \
            adapter/provider/provider.go; \
    fi

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        sed -i 's@return nil, fmt.Errorf("proxy %d error: %w", idx, err)@name, _ := mapping["name"].(string)\n                log.Warnln("[Provider %s] skip invalid proxy (idx=%d, name=%q): %v", pdName, idx, name, err)\n                continue@g' \
            adapter/provider/provider.go; \
    fi
  
# sed молча ничего не заменяет, если upstream переименовал строку. Без проверки
# это всплывает позже как невнятная ошибка go build.
RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then set -eu; \
      chk() { grep -Fq "$2" "$3" || { echo "patch did not apply: $1 ($3)" >&2; exit 1; }; }; \
      chk baseReleaseURL    'Medium1992/mihomo-proxy-ros/releases/latest/download/' component/updater/update_core.go; \
      chk versionReleaseURL 'Medium1992/mihomo-proxy-ros/releases/latest/download/version.txt' component/updater/update_core.go; \
      chk baseAlphaURL      'Medium1992/mihomo-proxy-ros/releases/download/alpha/'  component/updater/update_core.go; \
      chk versionAlphaURL   'Medium1992/mihomo-proxy-ros/releases/download/alpha/version.txt' component/updater/update_core.go; \
      chk providerLogImport '"github.com/metacubex/mihomo/log"'                     adapter/provider/provider.go; \
      chk providerSkip      'skip invalid proxy'                                    adapter/provider/provider.go; \
    fi

# Формируем список build tags и собираем
RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        echo "Applying fork name to the version banner"; \
        sed -i 's|"Mihomo Meta %s %s %s with %s %s|"%s Meta %s %s %s with %s %s|' main.go; \
        sed -i 's|C.Version, runtime.GOOS|C.MihomoName, C.Version, runtime.GOOS|' main.go; \
    fi

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then set -eu; \
      chk() { grep -Fq "$2" "$3" || { echo "patch did not apply: $1 ($3)" >&2; exit 1; }; }; \
      chk versionBanner     '"%s Meta %s %s %s with %s %s'      main.go; \
      chk versionBannerArgs 'C.MihomoName, C.Version, runtime.GOOS' main.go; \
    fi

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        echo "Applying Xray REALITY minClientVer compatibility patch"; \
        sed -i \
            -e 's/hello\.SessionId\[0\] = 1/hello.SessionId[0] = 26/' \
            -e 's/hello\.SessionId\[1\] = 8/hello.SessionId[1] = 3/' \
            -e 's/hello\.SessionId\[2\] = 2/hello.SessionId[2] = 27/' \
            component/tls/reality.go; \
    fi

RUN if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
      grep -Fq 'hello.SessionId[0] = 26' component/tls/reality.go && \
      grep -Fq 'hello.SessionId[1] = 3' component/tls/reality.go && \
      grep -Fq 'hello.SessionId[2] = 27' component/tls/reality.go \
        || { echo "patch did not apply: reality minClientVer (component/tls/reality.go)" >&2; exit 1; }; \
    fi

# Временная подмена utls: ветка v1.9.0-mod-meta (нативный JLS, отпечатки
# firefox 148 и safari 26.3). Пустой UTLS_OVERRIDE_BRANCH = собирать как в go.mod.
ARG UTLS_OVERRIDE_BRANCH=v1.9.0-mod-meta
RUN if [ -n "$UTLS_OVERRIDE_BRANCH" ]; then set -eu; \
      echo "Overriding github.com/metacubex/utls with branch $UTLS_OVERRIDE_BRANCH"; \
      git clone --depth=1 -b "$UTLS_OVERRIDE_BRANCH" https://github.com/MetaCubeX/utls.git /utls; \
      grep -Fqx 'module github.com/metacubex/utls' /utls/go.mod \
        || { echo "unexpected module path in /utls/go.mod" >&2; exit 1; }; \
      go mod edit -replace github.com/metacubex/utls=/utls; \
      go list -m github.com/metacubex/utls | grep -Fq '=> /utls' \
        || { echo "utls override did not apply" >&2; exit 1; }; \
      echo "utls: $UTLS_OVERRIDE_BRANCH $(git -C /utls rev-parse --short HEAD)"; \
    else \
      echo "Using utls from go.mod as is"; \
    fi

# Скретч-буфер записи HTTP/2 в форке github.com/metacubex/http: min(SETTINGS
# пира, 512 КиБ) на каждый аплинк-стрим. XHTTP с REALITY (auto -> stream-one /
# stream-up) и gun держат тело запроса открытым всю жизнь соединения, так что
# буфер приколочен на всё это время. Размер диктует пир (сервер или edge CDN),
# поэтому лечится только на клиенте. Upstream proposal golang/go#79831 предлагает
# ровно 32 КиБ. Пустое значение = собирать как у апстрима.
ARG H2_SCRATCH_KB=32
RUN set -eu; \
    if [ -z "$H2_SCRATCH_KB" ]; then \
      echo "HTTP/2 scratch buffer left at upstream defaults"; \
      exit 0; \
    fi; \
    printf '%s' "$H2_SCRATCH_KB" | grep -Eq '^[1-9][0-9]*$' \
      || { echo "H2_SCRATCH_KB is not a positive number: $H2_SCRATCH_KB" >&2; exit 1; }; \
    go mod download github.com/metacubex/http; \
    SRC=$(go list -m -f '{{.Dir}}' github.com/metacubex/http); \
    cp -r "$SRC" /mhttp; \
    chmod -R u+w /mhttp; \
    FILES=$(grep -rlF 'const max = 512 << 10' /mhttp || true); \
    [ -n "$FILES" ] \
      || { echo "frameScratchBufferLen no longer has the shape this patch expects" >&2; exit 1; }; \
    for f in $FILES; do sed -i "s|const max = 512 << 10|const max = ${H2_SCRATCH_KB} << 10|" "$f"; done; \
    ! grep -rqF 'const max = 512 << 10' /mhttp \
      || { echo "h2 scratch patch did not apply" >&2; exit 1; }; \
    go mod edit -replace github.com/metacubex/http=/mhttp; \
    go list -m github.com/metacubex/http | grep -Fq '=> /mhttp' \
      || { echo "metacubex/http override did not apply" >&2; exit 1; }; \
    echo "HTTP/2 uplink scratch buffer capped at ${H2_SCRATCH_KB} KiB in:" $FILES

RUN VERSION_FOR_BUILD="${TAG}" && \
    if [ -n "${VERSION_OVERRIDE}" ]; then VERSION_FOR_BUILD="${VERSION_OVERRIDE}"; fi && \
    if [ "$MIHOMO_CUSTOM_PATCHES" = "1" ]; then \
        MIHOMO_NAME="mihomo-proxy-ros"; \
    else \
        MIHOMO_NAME="mihomo"; \
    fi && \
    LD_FLAGS="-w -s -buildid= -X 'github.com/metacubex/mihomo/constant.Version=${VERSION_FOR_BUILD}' -X 'github.com/metacubex/mihomo/constant.BuildTime=${BUILDTIME}' -X 'github.com/metacubex/mihomo/constant.MihomoName=${MIHOMO_NAME}'" && \
    echo "Building TAG=${TAG} VERSION=${VERSION_FOR_BUILD} MIHOMO_CUSTOM_PATCHES=${MIHOMO_CUSTOM_PATCHES}" && \
    BUILD_TAGS="" && \
    if [ "$WITH_GVISOR" = "1" ]; then BUILD_TAGS="with_gvisor"; fi && \
    echo "Building with tags: $BUILD_TAGS" && \
    if [ "$TARGETARCH" = "amd64" ]; then \
        echo "Setting GOAMD64=$AMD64VERSION for amd64"; \
        CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOAMD64=$AMD64VERSION \
        go build -tags "$BUILD_TAGS" -trimpath -ldflags "$LD_FLAGS" -o /final/mihomo .; \
    elif [ "$TARGETARCH" = "arm" ]; then \
        if [ "$TARGETVARIANT" = "v5" ]; then \
            echo "Building for ARMv5 (GOARM=5)"; \
            CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=arm GOARM=5 \
            go build -tags "$BUILD_TAGS" -trimpath -ldflags "$LD_FLAGS" -o /final/mihomo .; \
        elif [ "$TARGETVARIANT" = "v7" ]; then \
            echo "Building for ARMv7 (GOARM=7)"; \
            CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=arm GOARM=7 \
            go build -tags "$BUILD_TAGS" -trimpath -ldflags "$LD_FLAGS" -o /final/mihomo .; \
        else \
            echo "Unknown ARM variant, defaulting to GOARM=7"; \
            CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=arm GOARM=7 \
            go build -tags "$BUILD_TAGS" -trimpath -ldflags "$LD_FLAGS" -o /final/mihomo .; \
        fi; \
    else \
        CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
        go build -tags "$BUILD_TAGS" -trimpath -ldflags "$LD_FLAGS" -o /final/mihomo .; \
    fi
    
FROM scratch AS export
COPY --from=package /final /
